@page "/orders"
@layout Layout.MainLayout

@using SultanCups.Models
@using SultanCups.Services

@inject SultanCups.Services.UserSession Session
@inject FinanceService2 FinanceService
@inject InventoryService InventoryService
@inject SalesService SalesService
@inject ToastService ToastService

<div class="pro-page">

    <div class="pro-topbar">
        <button class="pro-btn-add" @onclick="OpenAddDialog">إضافة فاتورة</button>
        <h2 class="pro-title">الفواتير</h2>
        <div></div>
    </div>

    <div class="pro-card">
        <div class="pro-table-wrap">
            <table class="pro-table">
                <thead>
                    <tr>
                        <th>رقم</th>
                        <th>النوع</th>
                        <th>الاسم</th>
                        <th>عدد الأصناف</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>الصافي</th>
                        <th>العمولة</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (OrdersList == null)
                    {
                        <tr>
                            <td colspan="10" class="st-empty-text">
                                <span>جاري التحميل...</span>
                            </td>
                        </tr>
                    }
                    else if (!OrdersList.Any())
                    {
                        <tr>
                            <td colspan="10" class="st-empty-text">
                                <div class="empty-state">
                                    <img src="images/Empty.jpg" class="empty-img" />
                                    <span>لا توجد فواتير</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in OrdersList)
                        {
                            <tr>
                                <td>#@o.order_id</td>

                                <td>@(o.person_type == "customer" ? "زبون" : "مسوق")</td>

                                <td>@o.person_name</td>

                                <td>@o.items_count</td>

                                <td class="pro-total">@Fmt(o.total)</td>

                                <td>@Fmt(o.discount_total)</td>

                                <td class="pro-total">@Fmt(o.net_total)</td>

                                <td>
                                    @(o.person_type == "marketer" ? Fmt(o.commission_total) : "-")
                                </td>

                                <td>@o.order_date.ToString("yyyy-MM-dd")</td>

                                <td>
                                    <button class="btn-info">تفاصيل</button>
                                    <button class="btn-edit">تعديل</button>
                                    <button class="btn-delete">تعطيل</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ShowAddDialog)
{
    <div class="pro-dialog-overlay">
        <div class="pro-dialog-box">

            <div class="pro-dialog-top-image inv-delete-top-image">
                <img src="images/Background.png" />
            </div>
            <div class="pro-dialog-body">

                <h3>إضافة فاتورة</h3>

                <div class="pro-fields-grid pro-animate">

                    <div>
                        <label>نوع الشخص</label>
                        <select class="pro-input" @bind="Form.person_type">
                            <option value="customer">زبون</option>
                            <option value="marketer">مسوق</option>
                        </select>
                    </div>

                    @if (Form.person_type == "customer")
                    {
                        <div>
                            <label>الزبون</label>
                            <select class="pro-input" @bind="Form.person_id">
                                <option value="0">اختر زبون</option>
                                @foreach (var c in Customers)
                                {
                                    <option value="@c.customer_id">@c.name</option>
                                }
                            </select>
                        </div>
                    }
                    @if (Form.person_type == "marketer")
                    {
                        <div>
                            <label>المسوق</label>
                            <select class="pro-input"
                                    value="@Form.person_id"
                                    @onchange="OnMarketerChanged">
                                <option value="0">اختر مسوق</option>
                                @foreach (var m in Marketers)
                                {
                                    <option value="@m.marketer_id">@m.name</option>
                                }
                            </select>
                        </div>

                        <!-- 🔥 هنا -->
                        <div>
                            <label>عمولة الصندوق</label>
                            <input class="pro-input" @bind="Form.commission_per_box" />
                        </div>
                    }
                    <div>
                        <label>التاريخ</label>
                        <input type="date" class="pro-input" @bind="Form.order_date" />
                    </div>

                   

                    <div>
                        <label>الخزنة</label>
                        <select class="pro-input" @bind="Form.cash_box_id">
                            <option value="0">اختر خزنة</option>
                            @foreach (var cb in CashBoxes)
                            {
                                <option value="@cb.cash_box_id">@cb.name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label>طريقة الدفع</label>
                        <select class="pro-input" @bind="Form.payment_method">
                            <option value="cash">نقدي</option>
                            <option value="card">بطاقة مصرفية</option>
                            <option value="transfer">تحويل</option>
                            <option value="check">شيك</option>
                        </select>
                    </div>

                    

                </div>

                <hr />

                <h4>الأصناف</h4>

                @foreach (var item in Form.Items)
                {
                    <div class="pro-fields-grid pro-item-animate" @key="item">



                        <div>
                            <label>المنتج</label>
                            <select class="pro-input"
                                    value="@item.product_id"
                                    @onchange="e => OnProductChanged(e, item)">
                                <option value="0">اختر منتج</option>
                                @foreach (var p in Products)
                                {
                                    <option value="@p.product_id">@p.name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label>سعر البيع</label>
                            <input class="pro-input"
                                   value="@Products.FirstOrDefault(p => p.product_id == item.product_id)?.sale_price"
                                   disabled />
                        </div>

                        <div>
                            <label>الكمية</label>
                            <input type="number"
                                   class="pro-input"
                                   @bind-value="item.quantity"
                                   @bind-value:event="oninput" />

                        </div>

                        <div>
                            <label>السعر</label>
                            <input type="number"
                                   step="0.01"
                                   class="pro-input"
                                   @bind-value="item.unit_price"
                                   @bind-value:event="oninput" />
                        </div>

                        <!-- 🔥 زر حذف -->
                        @if (Form.Items.Count > 1)
                        {
                            <button type="button"
                                    class="btn-delete-item"
                                    @onclick="() => RemoveItem(item)">
                                ✕
                            </button>
                        }

                       
                    </div>

                    <hr />
                }

                <button class="pro-btn-add" @onclick="AddItem">إضافة صنف أخر</button>
                <div class="invoice-summary">

                    <div class="pro-fields-grid" style="margin-top:10px;">

                        <div>
                            <label>الخصم</label>
                            <input type="number"
                                   step="0.01"
                                   class="pro-input"
                                   @bind-value="Form.discount_total"
                                   @bind-value:event="oninput" />
                        </div>

                        <div>
                            <label>المبلغ المدفوع</label>
                            <input type="number"
                                   class="pro-input"
                                   @bind-value="Form.paid_amount"
                                   @bind-value:event="oninput" />
                        </div>

                    </div>

                    <div class="sum-row">
                        <span>الإجمالي:</span>
                        <strong class="sum-value">@Fmt(Total)</strong>
                    </div>

                    <div class="sum-row">
                        <span>الخصم:</span>
                        <strong class="sum-value">@Fmt(Form.discount_total)</strong>
                    </div>

                    <div class="sum-row">
                        <span>الإجمالي بعد الخصم:</span>
                        <strong class="sum-value">@Fmt(Net)</strong>
                    </div>

                    @if (Form.person_type == "marketer")
                    {
                        <div class="sum-row">
                            <span>عمولة المسوق:</span>
                            <strong class="sum-value">@Fmt(Commission)</strong>
                        </div>
                    }

                </div>

                <div class="pur-notes-box">
                    <label>ملاحظات</label>
                    <textarea maxlength="200"
                              class="pro-input pur-notes-input"
                              @bind="Form.notes"></textarea>
                </div>

                <div class="pro-dialog-actions">
                    <button class="pro-save" @onclick="SaveOrder">حفظ</button>
                    <button class="pro-cancel" @onclick="Close">إلغاء</button>
                </div>

            </div>
        </div>
    </div>
}

@code {

    List<OrderView>? OrdersList;
    List<Product> Products = new();

    bool ShowAddDialog = false;

    int CurrentAdminId => Session.AdminId;

    Order Form = new();
    List<Customer> Customers = new();
    List<Marketer> Marketers = new();
    List<CashBox> CashBoxes = new(); // 🔥 جديد

    protected override async Task OnInitializedAsync()
    {
        Products = await InventoryService.GetProducts();
        Customers = await SalesService.GetActiveCustomers();
        Marketers = await SalesService.GetActiveMarketers();
        CashBoxes = await FinanceService.GetCashBoxes(); // 🔥 جديد
        OrdersList = await FinanceService.GetOrders();
    }
    void OpenAddDialog()
    {
        Form = new Order
        {
            order_date = DateTime.UtcNow,

            person_type = "marketer", // 🔥 الافتراضي مسوق
            person_id = 0,            // ❌ بدون اختيار

            Items = new List<OrderItem>
        {
            new OrderItem
            {
                product_id = 0, // ❌ لا تختار تلقائي
                quantity = 1,
                unit_price = 0
            }
        }
        };

        ShowAddDialog = true;
    }

    void RemoveItem(OrderItem item)
    {
        Form.Items.Remove(item);
    }

    void OnMarketerChanged(ChangeEventArgs e)
    {
        int id = int.Parse(e.Value.ToString());

        Form.person_id = id; // 🔥 مهم جداً

        var marketer = Marketers.FirstOrDefault(m => m.marketer_id == id);

        if (marketer != null)
        {
            Form.commission_per_box = marketer.commission_per_box;
        }
    }

    void Close()
    {
        ShowAddDialog = false;
    }

    void AddItem()
    {
        Form.Items.Add(new OrderItem
        {
            product_id = 0,
            quantity = 1,
            unit_price = 0
        });
    }

    //حساب الاجمالي

    decimal Total => Form.Items.Sum(i => i.quantity * i.unit_price);

    decimal Net => Math.Max(0, Total - Form.discount_total);

    decimal Commission
    {
        get
        {
            if (Form.person_type != "marketer")
                return 0;

            var marketer = Marketers.FirstOrDefault(m => m.marketer_id == Form.person_id);

            if (marketer == null)
                return 0;

            var qty = Form.Items.Sum(i => i.quantity);

            // 🔥 مسوق خاص
            if (marketer.is_special)
                return qty * Form.commission_per_box;

            // 🔥 مسوق عادي (لا نحسب هنا)
            return 0;
        }
    }

    void OnProductChanged(ChangeEventArgs e, OrderItem item)
    {
        int id = int.Parse(e.Value.ToString());

        item.product_id = id;

        var product = Products.FirstOrDefault(p => p.product_id == id);

        if (product != null)
        {
            item.unit_price = product.sale_price; // 🔥 أهم سطر
        }
    }

    async Task SaveOrder()
    {
        try
        {
            if (Form.person_id == 0)
            {
                ToastService.ShowToast("اختر الزبون أو المسوق", "warning");
                return;
            }

            if (!Form.Items.Any())
            {
                ToastService.ShowToast("أضف صنف واحد على الأقل", "warning");
                return;
            }

            if (Form.Items.Any(i => i.product_id == 0))
            {
                ToastService.ShowToast("اختر المنتج", "warning");
                return;
            }

            if (Form.Items.Any(i => i.quantity <= 0))
            {
                ToastService.ShowToast("الكمية غير صحيحة", "warning");
                return;
            }

            if (Form.cash_box_id == 0)
            {
                ToastService.ShowToast("اختر الخزنة", "warning");
                return;
            }

            // 🔥 حساب الصافي
            var net = Form.Items.Sum(i => i.quantity * i.unit_price) - Form.discount_total;

            if (Form.paid_amount <= 0)
            {
                ToastService.ShowToast("ادخل المبلغ المدفوع", "warning");
                return;
            }

            if (Form.paid_amount > net)
            {
                ToastService.ShowToast("المبلغ أكبر من الإجمالي", "warning");
                return;
            }

            Form.order_date = DateTime.UtcNow;

            var result = await FinanceService.AddOrder(
                Form,
                Form.Items,
                CurrentAdminId
            );

            if (result.success)
            {
                ToastService.ShowToast(result.message, "success");
                OrdersList = await FinanceService.GetOrders();

                ShowAddDialog = false;
                Form = new Order();
            }
            else
            {
                ToastService.ShowToast(result.message, "error");
            }
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            ToastService.ShowToast(msg, "error");
        }
    }

    string Fmt(decimal v) => $"{v:0.00} د.ل";

   
}